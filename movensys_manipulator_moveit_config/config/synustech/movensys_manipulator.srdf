<?xml version="1.0" encoding="utf-8"?>
<robot name="movensys_manipulator">

  <!-- Arm group as chain -->
  <group name="movensys_manipulator_arm">
    <chain base_link="Link0" tip_link="Link6"/>
  </group>

  <!--
    Group states. "zero" is the DUCO straight-up pose and was confirmed on the
    real arm on 2026-10-10 together with the joint signs. "initial" and "test"
    were recorded in simulation.
  -->
  <!-- "initial" recorded from /joint_states in Gazebo on 2026-10-07; keep in sync with initial_positions.yaml -->
  <group_state group="movensys_manipulator_arm" name="initial">
    <joint name="joint1" value="0.041"/>
    <joint name="joint2" value="-0.071"/>
    <joint name="joint3" value="1.618"/>
    <joint name="joint4" value="0.015"/>
    <joint name="joint5" value="-1.562"/>
    <joint name="joint6" value="1.511"/>
  </group_state>
  <group_state group="movensys_manipulator_arm" name="zero">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.0"/>
    <joint name="joint3" value="0.0"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>
  <!-- "test" recorded from /joint_states in Gazebo on 2026-10-07 -->
  <group_state group="movensys_manipulator_arm" name="test">
    <joint name="joint1" value="0.041"/>
    <joint name="joint2" value="-0.071"/>
    <joint name="joint3" value="1.618"/>
    <joint name="joint4" value="0.015"/>
    <joint name="joint5" value="-1.562"/>
    <joint name="joint6" value="0.096"/>
  </group_state>

  <!--
    Collision matrix generated with the MoveIt Setup Assistant on 2026-10-07,
    100000 samples. Of 45 link pairs, 8 are adjacent, 7 never collide and 30
    collide in some configurations, so only these 15 pairs are disabled. The
    table and Jetson box are reachable by Link2 to Link6 and must stay enabled.
  -->
  <disable_collisions link1="table" link2="jetson_thor" reason="Adjacent"/>
  <disable_collisions link1="table" link2="Link0" reason="Adjacent"/>
  <disable_collisions link1="table" link2="Link1" reason="Never"/>

  <disable_collisions link1="jetson_thor" link2="Link0" reason="Never"/>
  <disable_collisions link1="jetson_thor" link2="Link1" reason="Never"/>

  <disable_collisions link1="Link0" link2="Link1" reason="Adjacent"/>
  <disable_collisions link1="Link0" link2="Link2" reason="Never"/>

  <disable_collisions link1="Link1" link2="Link2" reason="Adjacent"/>
  <disable_collisions link1="Link1" link2="Link4" reason="Never"/>

  <disable_collisions link1="Link2" link2="Link3" reason="Adjacent"/>

  <disable_collisions link1="Link3" link2="Link4" reason="Adjacent"/>
  <disable_collisions link1="Link3" link2="Link5" reason="Never"/>

  <disable_collisions link1="Link4" link2="Link5" reason="Adjacent"/>
  <disable_collisions link1="Link4" link2="Link6" reason="Never"/>

  <disable_collisions link1="Link5" link2="Link6" reason="Adjacent"/>
</robot>
