Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: movensys_manipulator_isaac_ros_config/CuroboPanel
    Name: cuRobo
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
    - Class: rviz_default_plugins/RobotModel
      Name: Start state
      Enabled: true
      Alpha: 0.3
      TF Prefix: start
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /curobo/start_robot_description
    - Class: rviz_default_plugins/RobotModel
      Name: Goal
      Enabled: true
      Alpha: 0.4
      TF Prefix: goal
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /curobo/goal_robot_description
    - Class: rviz_default_plugins/InteractiveMarkers
      Name: Goal marker
      Enabled: true
      Interactive Markers Namespace: /curobo_goal
      Show Axes: false
      Show Descriptions: false
      Show Visual Aids: false
    - Class: rviz_default_plugins/Marker
      Name: Planned path
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /curobo/planned_path
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/Marker
      Name: Obstacles
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /curobo/obstacles
    - Class: rviz_default_plugins/Image
      Name: Depth
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /image_nvblox/depth
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world_manipulator
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.2
      Focal Point:
        X: 0.0
        Y: 0.1
        Z: 0.3
      Pitch: 0.6
      Yaw: 0.8
      Name: Current View
Window Geometry:
  Height: 900
  Width: 1400
