<?xml version="1.0"?>

<robot name="movensys_manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:include filename="$(find movensys_manipulator_description)/urdf/nachi_mz07/stage.xacro" />
    <xacro:include filename="$(find movensys_manipulator_description)/urdf/nachi_mz07/nachi_mz07.xacro"/>
    
    <link name="world_manipulator"/>

    <joint name="world_manipulator_to_table" type="fixed">
        <parent link="world_manipulator"/>
        <child  link="table"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:stage />

    <joint name="robot_joint" type="fixed">
        <origin xyz="0 0 0.005" rpy="0 0 0"/>
        <parent link="table"/>
        <child link="Link0"/>
    </joint>

    <xacro:nachi_mz07 joint_vel="3.0" joint_effort="1000"/>

</robot>
