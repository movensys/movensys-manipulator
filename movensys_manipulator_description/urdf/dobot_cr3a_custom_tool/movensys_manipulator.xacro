<?xml version="1.0"?>

<robot name="movensys_manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:include filename="$(find movensys_manipulator_description)/urdf/dobot_cr3a_custom_tool/stage.xacro" />
    <xacro:include filename="$(find movensys_manipulator_description)/urdf/dobot_cr3a_custom_tool/dobot_cr3a.xacro"/>
    <xacro:include filename="$(find movensys_manipulator_description)/urdf/dobot_cr3a_custom_tool/tool.xacro" />
    
    <link name="world_manipulator"/>

    <joint name="world_manipulator_to_table" type="fixed">
        <parent link="world_manipulator"/>
        <child  link="table"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:stage />

    <joint name="robot_joint" type="fixed">
        <origin xyz="-0.03 0.275 0.05" rpy="0 0 -1.57"/>
        <parent link="table"/>
        <child link="Link0"/>
    </joint>

    <xacro:dobot_cr3a joint_vel="3.0" joint_effort="1000"/>

    <!-- Tool mounted coaxially, directly on the Link6 flange -->
    <joint name="tool_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="Link6" />
      <child link="tool" />
    </joint>

    <xacro:tool />

</robot>
