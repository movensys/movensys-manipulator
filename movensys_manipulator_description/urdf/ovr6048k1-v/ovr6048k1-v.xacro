      <child link="Link1"/>
      <axis xyz="0 0 1"/>
      <limit effort="${joint_effort}" velocity="${joint_vel}" lower="-2.96705972839036" upper="2.96705972839036"/>
    </joint>
    <gazebo reference="joint1">
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
